  "tokenColors": [
    {
      "name": "Default text",
      "scope": ["source", "text"],
      "settings": { "foreground": "#B3B3B3" }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "comment.block.documentation",
        "punctuation.definition.comment"
      ],
      "settings": { "foreground": "#5e5e5e", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted.single",
        "string.quoted.double",
        "string.quoted.triple",
        "string.template",
        "string.quoted.other"
      ],
      "settings": { "foreground": "#5E90C7" }
    },
    {
      "name": "String escape / special chars",
      "scope": ["constant.character.escape", "constant.character"],
      "settings": { "foreground": "#B071BF" }
    },
    {
      "name": "Numbers, constants, floats",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.numeric.octal",
        "constant.other"
      ],
      "settings": { "foreground": "#EC9F41" }
    },
    {
      "name": "Booleans (True, False, null, None, undefined)",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.none",
        "constant.language.nan"
      ],
      "settings": { "foreground": "#BE5A79" }
    },
    {
      "name": "Functions and methods (definition + call)",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "meta.function-call entity.name.function",
        "meta.function-call.generic",
        "support.function",
        "support.function.builtin"
      ],
      "settings": { "foreground": "#98D750" }
    },
    {
      "name": "Types, structs, classes",
      "scope": [
        "storage.type",
        "support.type.builtin",
        "entity.name.type",
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.struct"
      ],
      "settings": { "foreground": "#DE4954" }
    },
    {
      "name": "Storage class / structure / typedef (var, let, const, static)",
      "scope": [
        "storage.modifier",
        "storage.type.function",
        "storage.type.class",
        "keyword.declaration"
      ],
      "settings": { "foreground": "#5E90C7" }
    },
    {
      "name": "Keywords — statements, operators, labels",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.operator.word",
        "keyword.other"
      ],
      "settings": { "foreground": "#B071BF" }
    },
    {
      "name": "Conditionals (if, else, elif, switch, case)",
      "scope": [
        "keyword.control.conditional",
        "keyword.control.if",
        "keyword.control.else",
        "keyword.control.switch"
      ],
      "settings": { "foreground": "#6E8FD4" }
    },
    {
      "name": "Import / include / export / require",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.import",
        "meta.import keyword",
        "support.module"
      ],
      "settings": { "foreground": "#B071BF" }
    },
    {
      "name": "Preprocessor / macros / defines",
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor",
        "entity.name.function.preprocessor"
      ],
      "settings": { "foreground": "#98D750" }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.bitwise"
      ],
      "settings": { "foreground": "#B071BF" }
    },
    {
      "name": "Delimiters, punctuation",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section.block",
        "meta.brace"
      ],
      "settings": { "foreground": "#B071BF" }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.parameter"
      ],
      "settings": { "foreground": "#B3B3B3" }
    },
    {
      "name": "self / this (donatello blue-purple)",
      "scope": [
        "variable.language.self",
        "variable.language.this",
        "variable.language.super"
      ],
      "settings": { "foreground": "#7482BC", "fontStyle": "italic" }
    },
    {
      "name": "Object properties / member access",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": { "foreground": "#B3B3B3" }
    },
    {
      "name": "Type annotations / hints / generics",
      "scope": ["meta.type.annotation", "meta.type.parameters", "support.type"],
      "settings": { "foreground": "#DE4954" }
    },
    {
      "name": "Decorators",
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": { "foreground": "#98D750", "fontStyle": "italic" }
    },
    {
      "name": "HTML/JSX tag names",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#B071BF" }
    },
    {
      "name": "HTML/JSX attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#98D750" }
    },
    {
      "name": "CSS class / id selectors",
      "scope": ["entity.name.selector", "meta.selector"],
      "settings": { "foreground": "#98D750" }
    },
    {
      "name": "CSS properties",
      "scope": ["support.type.property-name.css", "meta.property-name"],
      "settings": { "foreground": "#E6DB74" }
    },
    {
      "name": "CSS values / units",
      "scope": ["keyword.other.unit", "support.constant.property-value"],
      "settings": { "foreground": "#BE5A79" }
    },
    {
      "name": "CSS colors",
      "scope": ["constant.other.color"],
      "settings": { "foreground": "#BE5A79" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#5E90C7" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#EC9F41", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#5E90C7" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#6E8FD4" }
    },
    {
      "name": "Todo / fixme",
      "scope": ["comment.line.todo", "keyword.other.todo"],
      "settings": { "foreground": "#E1AD3D", "fontStyle": "bold italic" }
    },
    {
      "name": "Invalid / errors",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#DD4641", "fontStyle": "underline" }
    }
  ]
}
