  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#8a8a8a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted"],
      "settings": {
        "foreground": "#dfaf5f"
      }
    },
    {
      "name": "String Escape",
      "scope": ["constant.character.escape", "string.regexp"],
      "settings": {
        "foreground": "#5fafdf"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#ff5faf"
      }
    },
    {
      "name": "Boolean / Constant",
      "scope": ["constant.language", "constant.other"],
      "settings": {
        "foreground": "#dfaf00"
      }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "keyword.control"],
      "settings": {
        "foreground": "#00afaf"
      }
    },
    {
      "name": "Conditional / Repeat",
      "scope": [
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.flow"
      ],
      "settings": {
        "foreground": "#af87af"
      }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.accessor"],
      "settings": {
        "foreground": "#5fafdf"
      }
    },
    {
      "name": "Storage / Modifier",
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#df875f"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#afdf00"
      }
    },
    {
      "name": "Function / Method",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#5fafdf"
      }
    },
    {
      "name": "Variable / Identifier",
      "scope": ["variable", "variable.other", "entity.name.variable"],
      "settings": {
        "foreground": "#df875f"
      }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#d0d0d0"
      }
    },
    {
      "name": "Include / Import",
      "scope": ["keyword.control.import", "keyword.control.include", "keyword.other.using"],
      "settings": {
        "foreground": "#5faf5f"
      }
    },
    {
      "name": "Class Name",
      "scope": ["entity.name.class", "entity.name.namespace"],
      "settings": {
        "foreground": "#afdf00"
      }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": {
        "foreground": "#00afaf"
      }
    },
    {
      "name": "Tag Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#df875f"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "punctuation.definition"],
      "settings": {
        "foreground": "#8a8a8a"
      }
    },
    {
      "name": "Delimiter",
      "scope": ["punctuation.terminator", "punctuation.separator.comma"],
      "settings": {
        "foreground": "#5fafdf"
      }
    },
    {
      "name": "Special / Label",
      "scope": ["entity.name.label", "keyword.other"],
      "settings": {
        "foreground": "#dfaf00"
      }
    },
    {
      "name": "Markdown heading",
      "scope": ["markup.heading", "entity.name.section", "punctuation.definition.heading"],
      "settings": { "foreground": "#00afaf", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#dfaf5f" }
    },
    {
      "name": "Markdown link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#5fafdf" }
    },
    {
      "name": "Markdown quote",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#af87af", "fontStyle": "italic" }
    },
    {
      "name": "Diff added",
      "scope": ["markup.inserted", "diff.inserted"],
      "settings": { "foreground": "#5faf5f" }
    },
    {
      "name": "Diff removed",
      "scope": ["markup.deleted", "diff.deleted"],
      "settings": { "foreground": "#ff5faf" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#5faf5f",
        "fontStyle": "underline"
      }
    },
    {
      "name": "SQL Keywords",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.sql",
        "keyword.other.sql",
        "keyword.other.data-definition.create.sql",
        "keyword.other.alias.sql",
        "keyword.other.order.sql",
        "keyword.other.authorization.sql"
      ],
      "settings": { "foreground": "#00afaf" }
    },
    {
      "name": "SQL Data Types",
      "scope": ["storage.type.sql", "support.type.sql"],
      "settings": { "foreground": "#afdf00" }
    },
    {
      "name": "SQL Functions",
      "scope": [
        "support.function.aggregate.sql",
        "support.function.scalar.sql",
        "support.function.sql"
      ],
      "settings": { "foreground": "#5fafdf" }
    },
    {
      "name": "SQL Operators",
      "scope": [
        "keyword.operator.comparison.sql",
        "keyword.operator.math.sql",
        "keyword.operator.logical.sql"
      ],
      "settings": { "foreground": "#5fafdf" }
    },
    {
      "name": "Env Variable Key",
      "scope": [
        "variable.other.env",
        "support.constant.env",
        "string.interpolated.env variable.other.dotenv"
      ],
      "settings": { "foreground": "#ff5faf" }
    },
    {
      "name": "Env Variable Value",
      "scope": [
        "string.dotenv",
        "string.unquoted.env",
        "string.quoted.double.env",
        "string.quoted.single.env"
      ],
      "settings": { "foreground": "#dfaf5f" }
    },
    {
      "name": "Env Comment",
      "scope": [
        "comment.line.number-sign.dotenv",
        "comment.dotenv",
        "comment.line.number-sign.env"
      ],
      "settings": { "foreground": "#8a8a8a", "fontStyle": "italic" }
    }
  ]
}
