  "tokenColors": [
    {
      "name": "Default text",
      "scope": ["source", "text"],
      "settings": { "foreground": "#f6f3e8" }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "comment.block.documentation",
        "punctuation.definition.comment"
      ],
      "settings": { "foreground": "#99968b", "fontStyle": "italic" }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.import",
        "keyword.operator.word",
        "keyword.other"
      ],
      "settings": { "foreground": "#8ac6f2" }
    },
    {
      "name": "Conditionals and loops",
      "scope": [
        "keyword.control.conditional",
        "keyword.control.if",
        "keyword.control.else",
        "keyword.control.switch",
        "keyword.control.loop",
        "keyword.control.for",
        "keyword.control.while"
      ],
      "settings": { "foreground": "#8ac6f2" }
    },
    {
      "name": "Storage types",
      "scope": [
        "storage.modifier",
        "storage.type",
        "storage.type.function",
        "storage.type.class",
        "keyword.declaration"
      ],
      "settings": { "foreground": "#8ac6f2" }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted.single",
        "string.quoted.double",
        "string.quoted.triple",
        "string.template",
        "string.quoted.other"
      ],
      "settings": { "foreground": "#95e454", "fontStyle": "italic" }
    },
    {
      "name": "String escape sequences",
      "scope": ["constant.character.escape", "constant.character"],
      "settings": { "foreground": "#e7f6da" }
    },
    {
      "name": "Template literal expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": { "foreground": "#f6f3e8" }
    },
    {
      "name": "Numeric literals",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.numeric.octal"
      ],
      "settings": { "foreground": "#e5786d" }
    },
    {
      "name": "Boolean / null / undefined",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.none",
        "constant.language.nan"
      ],
      "settings": { "foreground": "#e5786d" }
    },
    {
      "name": "Constants / macros",
      "scope": [
        "constant.other",
        "variable.other.constant",
        "constant.other.caps"
      ],
      "settings": { "foreground": "#e5786d" }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.parameter"
      ],
      "settings": { "foreground": "#cae682" }
    },
    {
      "name": "this / self / super",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": { "foreground": "#cae682", "fontStyle": "italic" }
    },
    {
      "name": "Object properties / member access",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": { "foreground": "#f6f3e8" }
    },
    {
      "name": "Function names",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "meta.function-call entity.name.function",
        "meta.function-call.generic",
        "support.function",
        "support.function.builtin"
      ],
      "settings": { "foreground": "#cae682" }
    },
    {
      "name": "Types, classes, structs",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.struct"
      ],
      "settings": { "foreground": "#cae682" }
    },
    {
      "name": "Type annotations / hints",
      "scope": ["support.type", "support.type.builtin", "meta.type.annotation", "meta.type.parameters"],
      "settings": { "foreground": "#cae682" }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.bitwise"
      ],
      "settings": { "foreground": "#f6f3e8" }
    },
    {
      "name": "Punctuation / delimiters",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section.block",
        "meta.brace"
      ],
      "settings": { "foreground": "#f6f3e8" }
    },
    {
      "name": "Preprocessor / directives",
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor",
        "entity.name.function.preprocessor",
        "punctuation.definition.directive"
      ],
      "settings": { "foreground": "#e5786d" }
    },
    {
      "name": "Decorators",
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": { "foreground": "#e7f6da", "fontStyle": "italic" }
    },
    {
      "name": "HTML/JSX tag names",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#8ac6f2" }
    },
    {
      "name": "HTML/JSX attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#cae682", "fontStyle": "italic" }
    },
    {
      "name": "CSS selectors",
      "scope": ["entity.name.selector", "meta.selector"],
      "settings": { "foreground": "#cae682" }
    },
    {
      "name": "CSS properties",
      "scope": ["support.type.property-name.css", "meta.property-name"],
      "settings": { "foreground": "#8ac6f2" }
    },
    {
      "name": "CSS values / units",
      "scope": ["keyword.other.unit", "support.constant.property-value"],
      "settings": { "foreground": "#f6f3e8" }
    },
    {
      "name": "CSS colors",
      "scope": ["constant.other.color"],
      "settings": { "foreground": "#e5786d" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#cae682" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#cae682", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#95e454" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#8ac6f2" }
    },
    {
      "name": "Diff added",
      "scope": ["markup.inserted", "diff.inserted"],
      "settings": { "foreground": "#95e454" }
    },
    {
      "name": "Diff removed",
      "scope": ["markup.deleted", "diff.deleted"],
      "settings": { "foreground": "#e5786d" }
    },
    {
      "name": "Invalid / errors",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#e5786d", "fontStyle": "underline" }
    }
  ]
}
