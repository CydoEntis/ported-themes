  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#585C6C", "fontStyle": "italic" }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#AF8700" }
    },
    {
      "name": "String Escape",
      "scope": ["constant.character.escape", "string.regexp"],
      "settings": { "foreground": "#007687" }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#D70000" }
    },
    {
      "name": "Boolean / Constant",
      "scope": ["constant.language", "constant.other"],
      "settings": { "foreground": "#AF005F" }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "keyword.control"],
      "settings": { "foreground": "#7B1FA2", "fontStyle": "bold" }
    },
    {
      "name": "Conditional / Repeat",
      "scope": [
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.flow"
      ],
      "settings": { "foreground": "#7B1FA2", "fontStyle": "bold" }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#005F00" }
    },
    {
      "name": "Storage / Modifier",
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#7B1FA2", "fontStyle": "bold" }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": { "foreground": "#1F55A0" }
    },
    {
      "name": "Function / Method",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "entity.name.method"
      ],
      "settings": { "foreground": "#007687" }
    },
    {
      "name": "Variable / Identifier",
      "scope": ["variable", "variable.other", "entity.name.variable"],
      "settings": { "foreground": "#0F1019" }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#585C6C" }
    },
    {
      "name": "Include / PreProc",
      "scope": [
        "keyword.control.import",
        "keyword.control.include",
        "keyword.other.using",
        "meta.preprocessor",
        "keyword.control.directive"
      ],
      "settings": { "foreground": "#2D74D7" }
    },
    {
      "name": "Class Name",
      "scope": ["entity.name.class", "entity.name.namespace"],
      "settings": { "foreground": "#2D74D7" }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": { "foreground": "#AF005F", "fontStyle": "bold" }
    },
    {
      "name": "Tag Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#007687" }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.definition",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": { "foreground": "#585C6C" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#D70000", "fontStyle": "underline" }
    },
    {
      "name": "Markdown Heading",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#007687", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Heading Punctuation",
      "scope": ["punctuation.definition.heading.markdown"],
      "settings": { "foreground": "#585C6C" }
    },
    {
      "name": "Markdown Bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#0F1019", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#0F1019", "fontStyle": "italic" }
    },
    {
      "name": "Markdown Bold Italic",
      "scope": ["markup.bold markup.italic", "markup.italic markup.bold"],
      "settings": { "foreground": "#0F1019", "fontStyle": "bold italic" }
    },
    {
      "name": "Markdown Inline Code",
      "scope": ["markup.inline.raw.string.markdown", "markup.raw.inline"],
      "settings": { "foreground": "#AF8700" }
    },
    {
      "name": "Markdown Code Block",
      "scope": ["markup.fenced_code.block.markdown", "markup.raw.block"],
      "settings": { "foreground": "#AF8700" }
    },
    {
      "name": "Markdown Link URL",
      "scope": ["markup.underline.link", "markup.underline.link.image"],
      "settings": { "foreground": "#009B7C" }
    },
    {
      "name": "Markdown Link Text",
      "scope": ["string.other.link.title.markdown", "string.other.link.description.markdown"],
      "settings": { "foreground": "#007687" }
    },
    {
      "name": "Markdown Link Punctuation",
      "scope": [
        "punctuation.definition.link.markdown",
        "punctuation.definition.metadata.markdown",
        "punctuation.definition.string.begin.markdown",
        "punctuation.definition.string.end.markdown"
      ],
      "settings": { "foreground": "#585C6C" }
    },
    {
      "name": "Markdown Blockquote",
      "scope": ["markup.quote", "markup.quote.markdown"],
      "settings": { "foreground": "#585C6C", "fontStyle": "italic" }
    },
    {
      "name": "Markdown Blockquote Punctuation",
      "scope": ["punctuation.definition.blockquote.markdown"],
      "settings": { "foreground": "#005F00" }
    },
    {
      "name": "Markdown List Punctuation",
      "scope": ["punctuation.definition.list.begin.markdown", "beginning.punctuation.definition.list.markdown"],
      "settings": { "foreground": "#005F00" }
    },
    {
      "name": "Markdown Strikethrough",
      "scope": ["markup.strikethrough"],
      "settings": { "foreground": "#585C6C", "fontStyle": "strikethrough" }
    },
    {
      "name": "Markdown Separator",
      "scope": ["meta.separator.markdown"],
      "settings": { "foreground": "#585C6C" }
    },
    {
      "name": "Markdown Image Alt Text",
      "scope": ["string.other.link.description.title.markdown"],
      "settings": { "foreground": "#4E4E4E" }
    }
  ]
}
