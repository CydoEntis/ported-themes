  "tokenColors": [
    {
      "name": "Default text",
      "scope": ["source", "text"],
      "settings": { "foreground": "#f1f1f1" }
    },
    {
      "name": "Comment",
      "scope": ["comment", "comment.line", "comment.block", "comment.block.documentation", "punctuation.definition.comment"],
      "settings": { "foreground": "#686b78", "fontStyle": "italic" }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted.single", "string.quoted.double", "string.quoted.triple", "string.template", "string.quoted.other"],
      "settings": { "foreground": "#e4d867" }
    },
    {
      "name": "String Escape",
      "scope": ["constant.character.escape", "constant.character"],
      "settings": { "foreground": "#ef7c2a" }
    },
    {
      "name": "Template literal expression",
      "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": { "foreground": "#f1f1f1" }
    },
    {
      "name": "Regexp",
      "scope": ["string.regexp"],
      "settings": { "foreground": "#ef7c2a" }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric", "constant.numeric.integer", "constant.numeric.float", "constant.numeric.hex", "constant.numeric.octal"],
      "settings": { "foreground": "#ffad33" }
    },
    {
      "name": "Boolean / null / undefined",
      "scope": ["constant.language.boolean", "constant.language.null", "constant.language.undefined", "constant.language.none", "constant.language.nan"],
      "settings": { "foreground": "#ffad33" }
    },
    {
      "name": "Other constants",
      "scope": ["constant.language", "constant.other", "variable.other.constant", "constant.other.caps"],
      "settings": { "foreground": "#ffad33" }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "keyword.control", "keyword.control.flow", "keyword.other"],
      "settings": { "foreground": "#78bd65" }
    },
    {
      "name": "Import / Export",
      "scope": ["keyword.control.import", "keyword.control.export", "keyword.control.from", "keyword.import"],
      "settings": { "foreground": "#eb3d54" }
    },
    {
      "name": "Conditional / Repeat",
      "scope": ["keyword.control.conditional", "keyword.control.if", "keyword.control.else", "keyword.control.switch", "keyword.control.loop", "keyword.control.for", "keyword.control.while"],
      "settings": { "foreground": "#78bd65" }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator", "keyword.operator.arithmetic", "keyword.operator.assignment", "keyword.operator.comparison", "keyword.operator.logical", "keyword.operator.bitwise"],
      "settings": { "foreground": "#eb3d54" }
    },
    {
      "name": "Storage / Modifier",
      "scope": ["storage", "storage.type", "storage.modifier", "storage.type.function", "storage.type.class", "keyword.declaration"],
      "settings": { "foreground": "#ffad33" }
    },
    {
      "name": "Type",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.type.class", "entity.name.struct", "entity.other.inherited-class"],
      "settings": { "foreground": "#ffad33" }
    },
    {
      "name": "Type annotations",
      "scope": ["support.type", "support.type.builtin", "support.class", "meta.type.annotation", "meta.type.parameters"],
      "settings": { "foreground": "#ffad33" }
    },
    {
      "name": "Function / Method",
      "scope": ["entity.name.function", "entity.name.method", "meta.function-call entity.name.function", "meta.function-call.generic", "support.function", "support.function.builtin"],
      "settings": { "foreground": "#4fb4d8" }
    },
    {
      "name": "Variable / Identifier",
      "scope": ["variable", "variable.other", "variable.other.readwrite", "entity.name.variable"],
      "settings": { "foreground": "#4fb4d8" }
    },
    {
      "name": "this / self",
      "scope": ["variable.language.this", "variable.language.self", "variable.language.super"],
      "settings": { "foreground": "#4fb4d8", "fontStyle": "italic" }
    },
    {
      "name": "Object property",
      "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property"],
      "settings": { "foreground": "#f1f1f1" }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#f1f1f1" }
    },
    {
      "name": "Include / PreProc",
      "scope": ["keyword.control.include", "keyword.other.using", "meta.preprocessor", "keyword.control.directive"],
      "settings": { "foreground": "#eb3d54" }
    },
    {
      "name": "Class Name / Namespace",
      "scope": ["entity.name.class", "entity.name.namespace"],
      "settings": { "foreground": "#ffad33" }
    },
    {
      "name": "Decorator",
      "scope": ["entity.name.function.decorator", "meta.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#ffad33", "fontStyle": "italic" }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": { "foreground": "#78bd65" }
    },
    {
      "name": "Tag Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#4fb4d8" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "punctuation.definition", "punctuation.separator", "punctuation.accessor", "punctuation.terminator", "punctuation.section.block", "meta.brace"],
      "settings": { "foreground": "#848794" }
    },
    {
      "name": "CSS selector",
      "scope": ["entity.name.selector", "meta.selector"],
      "settings": { "foreground": "#78bd65" }
    },
    {
      "name": "CSS property",
      "scope": ["support.type.property-name.css", "meta.property-name"],
      "settings": { "foreground": "#4fb4d8" }
    },
    {
      "name": "CSS value / unit",
      "scope": ["keyword.other.unit", "support.constant.property-value"],
      "settings": { "foreground": "#f1f1f1" }
    },
    {
      "name": "CSS color",
      "scope": ["constant.other.color"],
      "settings": { "foreground": "#ef7c2a" }
    },
    {
      "name": "JSON key",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#4fb4d8" }
    },
    {
      "name": "Markdown heading",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#e4d867", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#ef7c2a" }
    },
    {
      "name": "Markdown link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#4fb4d8" }
    },
    {
      "name": "Diff added",
      "scope": ["markup.inserted", "diff.inserted"],
      "settings": { "foreground": "#78bd65" }
    },
    {
      "name": "Diff removed",
      "scope": ["markup.deleted", "diff.deleted"],
      "settings": { "foreground": "#eb3d54" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#eb3d54", "fontStyle": "underline" }
    },
    {
      "name": "SQL Keywords",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.sql",
        "keyword.other.sql",
        "keyword.other.data-definition.create.sql",
        "keyword.other.alias.sql",
        "keyword.other.order.sql",
        "keyword.other.authorization.sql"
      ],
      "settings": { "foreground": "#78bd65" }
    },
    {
      "name": "SQL Data Types",
      "scope": ["storage.type.sql", "support.type.sql"],
      "settings": { "foreground": "#ffad33" }
    },
    {
      "name": "SQL Functions",
      "scope": [
        "support.function.aggregate.sql",
        "support.function.scalar.sql",
        "support.function.sql"
      ],
      "settings": { "foreground": "#4fb4d8" }
    },
    {
      "name": "SQL Operators",
      "scope": [
        "keyword.operator.comparison.sql",
        "keyword.operator.math.sql",
        "keyword.operator.logical.sql"
      ],
      "settings": { "foreground": "#eb3d54" }
    },
    {
      "name": "Env Variable Key",
      "scope": [
        "variable.other.env",
        "support.constant.env",
        "string.interpolated.env variable.other.dotenv"
      ],
      "settings": { "foreground": "#ffad33" }
    },
    {
      "name": "Env Variable Value",
      "scope": [
        "string.dotenv",
        "string.unquoted.env",
        "string.quoted.double.env",
        "string.quoted.single.env"
      ],
      "settings": { "foreground": "#e4d867" }
    },
    {
      "name": "Env Comment",
      "scope": [
        "comment.line.number-sign.dotenv",
        "comment.dotenv",
        "comment.line.number-sign.env"
      ],
      "settings": { "foreground": "#686b78", "fontStyle": "italic" }
    }
  ]
}
