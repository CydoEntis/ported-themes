  "tokenColors": [
    {
      "name": "Default text",
      "scope": ["source", "text"],
      "settings": { "foreground": "#e9ecef" }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "comment.block.documentation",
        "punctuation.definition.comment"
      ],
      "settings": { "foreground": "#868e96" }
    },
    {
      "name": "Keywords / Statement",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.import",
        "keyword.operator.word",
        "keyword.other"
      ],
      "settings": { "foreground": "#d0bfff" }
    },
    {
      "name": "Conditionals and loops",
      "scope": [
        "keyword.control.conditional",
        "keyword.control.if",
        "keyword.control.else",
        "keyword.control.switch",
        "keyword.control.loop",
        "keyword.control.for",
        "keyword.control.while"
      ],
      "settings": { "foreground": "#91a7ff" }
    },
    {
      "name": "Storage types",
      "scope": [
        "storage.modifier",
        "storage.type",
        "storage.type.function",
        "storage.type.class",
        "keyword.declaration"
      ],
      "settings": { "foreground": "#d0bfff" }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted.single",
        "string.quoted.double",
        "string.quoted.triple",
        "string.template",
        "string.quoted.other"
      ],
      "settings": { "foreground": "#a9e34b" }
    },
    {
      "name": "String escape sequences",
      "scope": ["constant.character.escape", "constant.character"],
      "settings": { "foreground": "#ffa94d" }
    },
    {
      "name": "Template literal expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": { "foreground": "#ffec99" }
    },
    {
      "name": "Numeric literals",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.numeric.octal"
      ],
      "settings": { "foreground": "#ffa94d" }
    },
    {
      "name": "Boolean / null / undefined",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.none",
        "constant.language.nan"
      ],
      "settings": { "foreground": "#ffa94d" }
    },
    {
      "name": "Constants / macros",
      "scope": [
        "constant.other",
        "variable.other.constant",
        "constant.other.caps"
      ],
      "settings": { "foreground": "#ffd43b" }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.parameter"
      ],
      "settings": { "foreground": "#ffec99", "fontStyle": "bold" }
    },
    {
      "name": "this / self / super",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": { "foreground": "#ffec99", "fontStyle": "bold italic" }
    },
    {
      "name": "Object properties / member access",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": { "foreground": "#e9ecef" }
    },
    {
      "name": "Function names",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "meta.function-call entity.name.function",
        "meta.function-call.generic",
        "support.function",
        "support.function.builtin"
      ],
      "settings": { "foreground": "#ffec99", "fontStyle": "bold" }
    },
    {
      "name": "Types, classes, structs",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.struct"
      ],
      "settings": { "foreground": "#99e9f2" }
    },
    {
      "name": "Type annotations / hints",
      "scope": [
        "support.type",
        "support.type.builtin",
        "meta.type.annotation",
        "meta.type.parameters"
      ],
      "settings": { "foreground": "#99e9f2" }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.bitwise"
      ],
      "settings": { "foreground": "#99e9f2" }
    },
    {
      "name": "Punctuation / delimiters",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section.block",
        "meta.brace"
      ],
      "settings": { "foreground": "#868e96" }
    },
    {
      "name": "Preprocessor / directives",
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor",
        "entity.name.function.preprocessor",
        "punctuation.definition.directive"
      ],
      "settings": { "foreground": "#d0bfff" }
    },
    {
      "name": "Decorators",
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": { "foreground": "#ffd43b", "fontStyle": "italic" }
    },
    {
      "name": "HTML/JSX tag names",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#91a7ff" }
    },
    {
      "name": "HTML/JSX attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#ffec99", "fontStyle": "italic" }
    },
    {
      "name": "CSS selectors",
      "scope": ["entity.name.selector", "meta.selector"],
      "settings": { "foreground": "#d0bfff" }
    },
    {
      "name": "CSS properties",
      "scope": ["support.type.property-name.css", "meta.property-name"],
      "settings": { "foreground": "#99e9f2" }
    },
    {
      "name": "CSS values / units",
      "scope": ["keyword.other.unit", "support.constant.property-value"],
      "settings": { "foreground": "#e9ecef" }
    },
    {
      "name": "CSS colors",
      "scope": ["constant.other.color"],
      "settings": { "foreground": "#ffa94d" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#ffec99", "fontStyle": "bold" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#91a7ff", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#a9e34b" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#748ffc" }
    },
    {
      "name": "Diff added",
      "scope": ["markup.inserted", "diff.inserted"],
      "settings": { "foreground": "#a9e34b" }
    },
    {
      "name": "Diff removed",
      "scope": ["markup.deleted", "diff.deleted"],
      "settings": { "foreground": "#ff6b6b" }
    },
    {
      "name": "Invalid / errors",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ff6b6b", "fontStyle": "underline" }
    },
    {
      "name": "SQL Keywords",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.sql",
        "keyword.other.sql",
        "keyword.other.data-definition.create.sql",
        "keyword.other.alias.sql",
        "keyword.other.order.sql",
        "keyword.other.authorization.sql"
      ],
      "settings": { "foreground": "#d0bfff" }
    },
    {
      "name": "SQL Data Types",
      "scope": ["storage.type.sql", "support.type.sql"],
      "settings": { "foreground": "#99e9f2" }
    },
    {
      "name": "SQL Functions",
      "scope": [
        "support.function.aggregate.sql",
        "support.function.scalar.sql",
        "support.function.sql"
      ],
      "settings": { "foreground": "#ffec99" }
    },
    {
      "name": "SQL Operators",
      "scope": [
        "keyword.operator.comparison.sql",
        "keyword.operator.math.sql",
        "keyword.operator.logical.sql"
      ],
      "settings": { "foreground": "#99e9f2" }
    },
    {
      "name": "Env Variable Key",
      "scope": [
        "variable.other.env",
        "support.constant.env",
        "string.interpolated.env variable.other.dotenv"
      ],
      "settings": { "foreground": "#ffa94d" }
    },
    {
      "name": "Env Variable Value",
      "scope": [
        "string.dotenv",
        "string.unquoted.env",
        "string.quoted.double.env",
        "string.quoted.single.env"
      ],
      "settings": { "foreground": "#a9e34b" }
    },
    {
      "name": "Env Comment",
      "scope": [
        "comment.line.number-sign.dotenv",
        "comment.dotenv",
        "comment.line.number-sign.env"
      ],
      "settings": { "foreground": "#868e96", "fontStyle": "italic" }
    }
  ]
}
