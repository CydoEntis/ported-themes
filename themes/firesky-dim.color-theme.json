  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6ba8a5", "fontStyle": "italic" }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#6ba8a5" }
    },
    {
      "name": "String Escape / Regexp",
      "scope": ["constant.character.escape", "string.regexp"],
      "settings": { "foreground": "#9bc8cb" }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#ff8f40" }
    },
    {
      "name": "Boolean / Constant",
      "scope": ["constant.language", "constant.other"],
      "settings": { "foreground": "#ff8f40" }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "keyword.control"],
      "settings": { "foreground": "#d4803d" }
    },
    {
      "name": "Conditional / Repeat",
      "scope": ["keyword.control.conditional", "keyword.control.loop", "keyword.control.flow"],
      "settings": { "foreground": "#d4803d", "fontStyle": "bold" }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#40c4c0" }
    },
    {
      "name": "Storage / Modifier",
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#d4803d" }
    },
    {
      "name": "Type",
      "scope": ["entity.name.type", "entity.other.inherited-class", "support.type", "support.class"],
      "settings": { "foreground": "#ff8f40" }
    },
    {
      "name": "Function / Method",
      "scope": ["entity.name.function", "meta.function-call", "support.function", "entity.name.method"],
      "settings": { "foreground": "#7bb8bb" }
    },
    {
      "name": "Variable / Identifier",
      "scope": ["variable", "variable.other", "entity.name.variable"],
      "settings": { "foreground": "#f5f0e8" }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#f5f0e8" }
    },
    {
      "name": "Include / PreProc",
      "scope": ["keyword.control.import", "keyword.control.include", "keyword.other.using", "meta.preprocessor", "keyword.control.directive"],
      "settings": { "foreground": "#d4803d", "fontStyle": "italic" }
    },
    {
      "name": "Class Name",
      "scope": ["entity.name.class", "entity.name.namespace"],
      "settings": { "foreground": "#ff8f40" }
    },
    {
      "name": "Special / Escape",
      "scope": ["constant.character", "support.constant"],
      "settings": { "foreground": "#9bc8cb" }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": { "foreground": "#d4803d" }
    },
    {
      "name": "Tag Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#f5f0e8" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "punctuation.definition", "punctuation.separator", "punctuation.accessor"],
      "settings": { "foreground": "#e8ddd5" }
    },
    {
      "name": "Markdown heading",
      "scope": ["markup.heading", "entity.name.section", "punctuation.definition.heading"],
      "settings": { "foreground": "#d4803d", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#6ba8a5" }
    },
    {
      "name": "Markdown link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#40c4c0" }
    },
    {
      "name": "Markdown quote",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#7bb8bb", "fontStyle": "italic" }
    },
    {
      "name": "Diff added",
      "scope": ["markup.inserted", "diff.inserted"],
      "settings": { "foreground": "#1a7578" }
    },
    {
      "name": "Diff removed",
      "scope": ["markup.deleted", "diff.deleted"],
      "settings": { "foreground": "#ff4d1a" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ff4d1a", "fontStyle": "underline" }
    }
  ]
}
