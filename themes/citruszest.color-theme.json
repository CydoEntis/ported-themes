  "tokenColors": [
    {
      "name": "Default text",
      "scope": ["source", "text"],
      "settings": { "foreground": "#BFBFBF" }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "comment.block.documentation",
        "punctuation.definition.comment"
      ],
      "settings": { "foreground": "#659B75" }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.import",
        "keyword.operator.word",
        "keyword.other"
      ],
      "settings": { "foreground": "#28C9FF" }
    },
    {
      "name": "Conditionals and loops",
      "scope": [
        "keyword.control.conditional",
        "keyword.control.if",
        "keyword.control.else",
        "keyword.control.switch",
        "keyword.control.loop",
        "keyword.control.for",
        "keyword.control.while"
      ],
      "settings": { "foreground": "#33ffff" }
    },
    {
      "name": "Storage / declaration keywords",
      "scope": [
        "storage.modifier",
        "storage.type",
        "storage.type.function",
        "storage.type.class",
        "keyword.declaration"
      ],
      "settings": { "foreground": "#FF1A75" }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted.single",
        "string.quoted.double",
        "string.quoted.triple",
        "string.template",
        "string.quoted.other"
      ],
      "settings": { "foreground": "#B2F3AC" }
    },
    {
      "name": "String escape sequences",
      "scope": ["constant.character.escape", "constant.character"],
      "settings": { "foreground": "#FF1A75" }
    },
    {
      "name": "Template literal expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": { "foreground": "#FFFF00" }
    },
    {
      "name": "Numeric literals",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.numeric.octal"
      ],
      "settings": { "foreground": "#FFF2B3" }
    },
    {
      "name": "Boolean",
      "scope": [
        "constant.language.boolean"
      ],
      "settings": { "foreground": "#FFAA54" }
    },
    {
      "name": "Null / undefined",
      "scope": [
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.none",
        "constant.language.nan"
      ],
      "settings": { "foreground": "#FF5454" }
    },
    {
      "name": "Constants / macros",
      "scope": [
        "constant.other",
        "variable.other.constant",
        "constant.other.caps"
      ],
      "settings": { "foreground": "#FF7431" }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite"
      ],
      "settings": { "foreground": "#F9F9F9" }
    },
    {
      "name": "Variable parameters",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#28C9FF", "fontStyle": "italic" }
    },
    {
      "name": "this / self / super",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": { "foreground": "#FFFF00", "fontStyle": "italic" }
    },
    {
      "name": "Object properties / member access",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property"
      ],
      "settings": { "foreground": "#FFAA54" }
    },
    {
      "name": "Function names",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "meta.function-call entity.name.function",
        "meta.function-call.generic",
        "support.function",
        "support.function.builtin"
      ],
      "settings": { "foreground": "#1AFFA3" }
    },
    {
      "name": "Types, classes, structs",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.struct"
      ],
      "settings": { "foreground": "#FFAA54" }
    },
    {
      "name": "Type annotations / hints",
      "scope": [
        "support.type",
        "support.type.builtin",
        "meta.type.annotation",
        "meta.type.parameters"
      ],
      "settings": { "foreground": "#FFAA54" }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.bitwise"
      ],
      "settings": { "foreground": "#FFFF00" }
    },
    {
      "name": "Punctuation / delimiters",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section.block",
        "meta.brace"
      ],
      "settings": { "foreground": "#FF7431" }
    },
    {
      "name": "Preprocessor / directives",
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor",
        "entity.name.function.preprocessor",
        "punctuation.definition.directive"
      ],
      "settings": { "foreground": "#00BFFF" }
    },
    {
      "name": "Decorators",
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": { "foreground": "#FFAA54", "fontStyle": "italic" }
    },
    {
      "name": "HTML/JSX tag names",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#00BFFF" }
    },
    {
      "name": "HTML/JSX attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#FFD700", "fontStyle": "italic" }
    },
    {
      "name": "CSS selectors",
      "scope": ["entity.name.selector", "meta.selector"],
      "settings": { "foreground": "#FFAA54" }
    },
    {
      "name": "CSS properties",
      "scope": ["support.type.property-name.css", "meta.property-name"],
      "settings": { "foreground": "#FFAA54" }
    },
    {
      "name": "CSS values / units",
      "scope": ["keyword.other.unit", "support.constant.property-value"],
      "settings": { "foreground": "#FFD700" }
    },
    {
      "name": "CSS colors",
      "scope": ["constant.other.color"],
      "settings": { "foreground": "#FF7431" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#1AFFA3" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#00BFFF", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#FFF2B3" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#9ADCFF" }
    },
    {
      "name": "Diff added",
      "scope": ["markup.inserted", "diff.inserted"],
      "settings": { "foreground": "#1AFFA3" }
    },
    {
      "name": "Diff removed",
      "scope": ["markup.deleted", "diff.deleted"],
      "settings": { "foreground": "#FF5454" }
    },
    {
      "name": "Invalid / errors",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#FF5454", "fontStyle": "underline" }
    },
    {
      "name": "SQL Keywords",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.sql",
        "keyword.other.sql",
        "keyword.other.data-definition.create.sql",
        "keyword.other.alias.sql",
        "keyword.other.order.sql",
        "keyword.other.authorization.sql"
      ],
      "settings": { "foreground": "#28C9FF" }
    },
    {
      "name": "SQL Data Types",
      "scope": ["storage.type.sql", "support.type.sql"],
      "settings": { "foreground": "#FFAA54" }
    },
    {
      "name": "SQL Functions",
      "scope": [
        "support.function.aggregate.sql",
        "support.function.scalar.sql",
        "support.function.sql"
      ],
      "settings": { "foreground": "#1AFFA3" }
    },
    {
      "name": "SQL Operators",
      "scope": [
        "keyword.operator.comparison.sql",
        "keyword.operator.math.sql",
        "keyword.operator.logical.sql"
      ],
      "settings": { "foreground": "#FFFF00" }
    },
    {
      "name": "Env Variable Key",
      "scope": [
        "variable.other.env",
        "support.constant.env",
        "string.interpolated.env variable.other.dotenv"
      ],
      "settings": { "foreground": "#FFF2B3" }
    },
    {
      "name": "Env Variable Value",
      "scope": [
        "string.dotenv",
        "string.unquoted.env",
        "string.quoted.double.env",
        "string.quoted.single.env"
      ],
      "settings": { "foreground": "#B2F3AC" }
    },
    {
      "name": "Env Comment",
      "scope": [
        "comment.line.number-sign.dotenv",
        "comment.dotenv",
        "comment.line.number-sign.env"
      ],
      "settings": { "foreground": "#659B75", "fontStyle": "italic" }
    }
  ]
}
