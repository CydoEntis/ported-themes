  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#87ceeb",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted"],
      "settings": {
        "foreground": "#ff8080"
      }
    },
    {
      "name": "String Escape / Regexp",
      "scope": ["constant.character.escape", "string.regexp"],
      "settings": {
        "foreground": "#ffc266"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#ff8080"
      }
    },
    {
      "name": "Boolean / Constant",
      "scope": ["constant.language", "constant.other"],
      "settings": {
        "foreground": "#ff8080"
      }
    },
    {
      "name": "Keyword / Statement",
      "scope": ["keyword", "keyword.control"],
      "settings": {
        "foreground": "#f0e260",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Conditional / Repeat",
      "scope": [
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.flow"
      ],
      "settings": {
        "foreground": "#f0e260",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Storage / Modifier",
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#f0e260",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#91b365",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function / Method",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#98fb98"
      }
    },
    {
      "name": "Variable / Identifier",
      "scope": ["variable", "variable.other", "entity.name.variable"],
      "settings": {
        "foreground": "#98fb98"
      }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Include / PreProc",
      "scope": [
        "keyword.control.import",
        "keyword.control.include",
        "keyword.other.using",
        "meta.preprocessor",
        "keyword.control.directive"
      ],
      "settings": {
        "foreground": "#cd5c5c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Class Name",
      "scope": ["entity.name.class", "entity.name.namespace"],
      "settings": {
        "foreground": "#91b365",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Special",
      "scope": ["constant.character", "support.constant", "keyword.other"],
      "settings": {
        "foreground": "#ffc266"
      }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": {
        "foreground": "#f0e260"
      }
    },
    {
      "name": "Tag Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#98fb98"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "punctuation.definition", "punctuation.separator", "punctuation.accessor"],
      "settings": {
        "foreground": "#aaaaaa"
      }
    },
    {
      "name": "Markdown heading",
      "scope": ["markup.heading", "entity.name.section", "punctuation.definition.heading"],
      "settings": { "foreground": "#f0e260", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#ff8080" }
    },
    {
      "name": "Markdown link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#87ceeb" }
    },
    {
      "name": "Markdown quote",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#98fb98", "fontStyle": "italic" }
    },
    {
      "name": "Diff added",
      "scope": ["markup.inserted", "diff.inserted"],
      "settings": { "foreground": "#98fb98" }
    },
    {
      "name": "Diff removed",
      "scope": ["markup.deleted", "diff.deleted"],
      "settings": { "foreground": "#ff8080" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#ffffff",
        "fontStyle": "underline"
      }
    }
  ]
}
